<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 everywhere. On a Windows host a second target is added so the Windows adapter
         (which is net10.0-windows, because it uses Core's Windows-only types) can be referenced
         and its tests actually run. macOS and Linux keep building the single portable target. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0;net10.0-windows</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>BrowserFlip.Prototype.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1861;CA1812</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit v3, required by Avalonia.Headless.XUnit 12.x. The product's own test projects
         stay on xunit 2.9.3; the two live in different solutions and never mix. -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Skia so the headless tests render real frames instead of a no-op surface. -->
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The SDK defines the WINDOWS symbol for net10.0-windows, which is what guards
       WindowsAdapterTests.cs; under net10.0 that file compiles to nothing. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\..\src\BrowserFlip.Platform.Windows\BrowserFlip.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BrowserFlip.UI\BrowserFlip.UI.csproj" />
    <ProjectReference Include="..\..\src\BrowserFlip.Platform.MacOS\BrowserFlip.Platform.MacOS.csproj" />
    <ProjectReference Include="..\..\src\BrowserFlip.Platform.Linux\BrowserFlip.Platform.Linux.csproj" />
    <ProjectReference Include="..\..\..\..\src\BrowserFlip.Core\BrowserFlip.Core.csproj" />
  </ItemGroup>

</Project>
