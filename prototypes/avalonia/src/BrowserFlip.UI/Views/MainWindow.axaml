<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BrowserFlip.UI.ViewModels"
        xmlns:views="using:BrowserFlip.UI.Views"
        x:Class="BrowserFlip.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="560" MinWidth="460" Height="620" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Title="{Binding Title}">

  <Window.Resources>
    <views:PngToBitmapConverter x:Key="PngToBitmap" />
  </Window.Resources>

  <DockPanel Margin="16">

    <!-- Header: the current default, straight out of BrowserFlip.Core's status enumeration. -->
    <StackPanel DockPanel.Dock="Top" Spacing="4">
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding CurrentDefaultText}" TextWrapping="Wrap" Opacity="0.85" />
      <TextBlock Text="{Binding MechanismDescription}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
      <Separator Margin="0,8" />
    </StackPanel>

    <!-- Footer: settings that are persisted to disk. -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <Separator />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding LabelLanguage}" VerticalAlignment="Center" />
        <ComboBox x:Name="LanguageBox" Width="150" ItemsSource="{Binding LanguageChoices}"
                  SelectedItem="{Binding SelectedLanguage}" DisplayMemberBinding="{Binding Display}" />
        <Button x:Name="RefreshButton" Content="{Binding LabelRefresh}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <CheckBox Content="{Binding LabelTopmost}" IsChecked="{Binding Topmost}" />
        <CheckBox Content="{Binding LabelShowToolbar}" IsChecked="{Binding ShowFloatingToolbar}" />
      </StackPanel>
      <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap">
        <Run Text="{Binding LabelSettingsFile}" />
        <Run Text=": " />
        <Run Text="{Binding SettingsLocation}" />
      </TextBlock>
      <TextBlock FontSize="11" Opacity="0.6">
        <Run Text="launch #" />
        <Run Text="{Binding LaunchCount}" />
      </TextBlock>
      <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap" Foreground="#0a7" />
    </StackPanel>

    <!-- The browser list fills whatever height is left between the header and the footer. -->
    <Grid RowDefinitions="Auto,Auto,*">
      <TextBlock Grid.Row="0" Text="{Binding LabelBrowsers}" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBlock Grid.Row="1" Text="{Binding LabelEmpty}" Opacity="0.6"
                 IsVisible="{Binding !Browsers.Count}" />
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="BrowserList" ItemsSource="{Binding Browsers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BrowserItemViewModel">
              <Border Margin="0,0,0,6" Padding="10" CornerRadius="8" BorderThickness="1"
                      BorderBrush="#30808080">
                <Grid ColumnDefinitions="40,*,Auto">
                  <Image Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center"
                         Source="{Binding IconPng, Converter={StaticResource PngToBitmap}}" />
                  <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                      <Border IsVisible="{Binding IsDefault}" Background="#0a7" CornerRadius="4"
                              Padding="5,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DefaultBadgeLabel}" FontSize="10" Foreground="White" />
                      </Border>
                      <Border IsVisible="{Binding IsPartialDefault}" Background="#d80" CornerRadius="4"
                              Padding="5,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PartialBadgeLabel}" FontSize="10" Foreground="White" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Identifier}" FontSize="11" Opacity="0.6" />
                  </StackPanel>
                  <Button Grid.Column="2" VerticalAlignment="Center" Content="{Binding SetDefaultLabel}"
                          IsEnabled="{Binding CanSetDefault}"
                          Click="OnSetDefaultClick" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

  </DockPanel>
</Window>
