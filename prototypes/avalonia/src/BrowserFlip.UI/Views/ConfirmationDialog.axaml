<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BrowserFlip.UI.Views.ConfirmationDialog"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <StackPanel Margin="24" Spacing="16">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" IsCancel="True" />
      <Button x:Name="ConfirmButton" Content="Change default browser" MinWidth="90" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
