<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BrowserFlip.UI</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <!-- Reuses the shipping Core unchanged, through its portable net10.0 target (added in R1). -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\BrowserFlip.Core\BrowserFlip.Core.csproj" />
  </ItemGroup>

  <!-- The product's existing translations, reused as-is. The .resx files are NOT copied or
       modified: they are linked out of the WPF project so there is a single source of truth. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\src\BrowserFlip.App\Resources\Strings.resx" LogicalName="BrowserFlip.UI.Localization.Strings.resources" />
    <EmbeddedResource Include="..\..\..\..\src\BrowserFlip.App\Resources\Strings.ja.resx" LogicalName="BrowserFlip.UI.Localization.Strings.ja.resources" />
    <EmbeddedResource Include="..\..\..\..\src\BrowserFlip.App\Resources\Strings.zh-CN.resx" LogicalName="BrowserFlip.UI.Localization.Strings.zh-CN.resources" />
  </ItemGroup>

  <!-- Strings that exist only in this prototype: the capability table, the consent wording and
       the per-platform mechanism description. They are deliberately NOT added to the shipping
       product's .resx; Strings.Get falls back to this set. Same three languages, so none of
       this text can be English-only in a Japanese or Chinese UI.
       Update, not Include: the SDK already globs .resx under the project directory, and the
       only thing being set here is the manifest name the ResourceManager looks for. -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\PrototypeStrings.resx" LogicalName="BrowserFlip.UI.Localization.PrototypeStrings.resources" />
    <EmbeddedResource Update="Localization\PrototypeStrings.ja.resx" LogicalName="BrowserFlip.UI.Localization.PrototypeStrings.ja.resources" />
    <EmbeddedResource Update="Localization\PrototypeStrings.zh-CN.resx" LogicalName="BrowserFlip.UI.Localization.PrototypeStrings.zh-CN.resources" />
  </ItemGroup>

  <!-- The product's own icon, so the tray item is not exported with an empty icon. -->
  <ItemGroup>
    <AvaloniaResource Include="..\..\..\..\assets\icon\png\browserflip-64.png" Link="Assets/trayicon.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BrowserFlip.Prototype.Tests" />
  </ItemGroup>

</Project>
