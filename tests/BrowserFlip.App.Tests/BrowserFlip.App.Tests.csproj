<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>BrowserFlip.Core.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Share the in-memory fakes with the Core tests. -->
    <Compile Include="..\BrowserFlip.Core.Tests\Fakes.cs" Link="Fakes.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BrowserFlip.App\BrowserFlip.App.csproj" />
    <ProjectReference Include="..\..\src\BrowserFlip.Core\BrowserFlip.Core.csproj" />
  </ItemGroup>

</Project>
