<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 runs everywhere (macOS/Linux/Windows); net10.0-windows additionally
         compiles the native-API smoke tests under Platform/. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test naming (underscores) and test-only patterns. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007;CA1861</NoWarn>
  </PropertyGroup>

  <!-- Tests that call real Windows APIs. Not compiled for the portable target, and skipped
       at run time when the net10.0-windows target is executed on a non-Windows host. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Platform\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BrowserFlip.Core\BrowserFlip.Core.csproj" />
  </ItemGroup>

  <!-- Resource files of the WPF app, checked for key parity across languages. -->
  <ItemGroup>
    <None Include="..\..\src\BrowserFlip.App\Resources\Strings*.resx" LinkBase="Resx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
