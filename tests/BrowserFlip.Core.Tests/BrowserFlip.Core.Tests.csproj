<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test naming (underscores) and test-only patterns. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BrowserFlip.Core\BrowserFlip.Core.csproj" />
  </ItemGroup>

  <!-- Resource files of the WPF app, checked for key parity across languages. -->
  <ItemGroup>
    <None Include="..\..\src\BrowserFlip.App\Resources\Strings*.resx" LinkBase="Resx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
