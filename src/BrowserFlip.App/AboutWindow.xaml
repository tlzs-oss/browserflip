<Window x:Class="BrowserFlip.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BrowserFlip.App.Localization"
        xmlns:views="clr-namespace:BrowserFlip.App.Views"
        Title="{Binding [About_Title], Source={x:Static loc:Loc.Instance}}"
        Icon="pack://application:,,,/BrowserFlip;component/Assets/browserflip.ico"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource BfWindowBackgroundBrush}"
        Foreground="{DynamicResource BfPrimaryTextBrush}"
        FontSize="{StaticResource BfFontBody}">
    <StackPanel Margin="24,20,24,16" Width="420">
        <views:AboutContent />
        <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Right" MinWidth="88" Margin="0,16,0,0"
                IsDefault="True" IsCancel="True" Click="OnOk"
                Content="{Binding [Dialog_OK], Source={x:Static loc:Loc.Instance}}" />
    </StackPanel>
</Window>
