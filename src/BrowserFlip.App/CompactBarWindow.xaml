<Window x:Class="BrowserFlip.App.CompactBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BrowserFlip.App.Localization"
        Title="BrowserFlip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        UseLayoutRounding="True"

        Foreground="{DynamicResource BfPrimaryTextBrush}"
        FontSize="13"
        AutomationProperties.Name="{Binding [Bar_Name], Source={x:Static loc:Loc.Instance}}">

    <Window.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BfPrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Width" Value="{Binding DataContext.Shell.BarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Height" Value="{Binding DataContext.Shell.BarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Expanded toolbar -->
        <Border x:Name="BarRoot" CornerRadius="12" BorderThickness="1" Padding="3"
                Background="{DynamicResource BfCardBackgroundBrush}" BorderBrush="{DynamicResource BfCardBorderBrush}"
                MouseLeftButtonDown="OnBarMouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <!-- Hidden, not Collapsed: the bar keeps its measured size while only the edge strip
                             shows, so the strip and its trigger zone always match the real bar length. -->
                        <DataTrigger Binding="{Binding Shell.IsBarCollapsed}" Value="True">
                            <Setter Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel x:Name="BarPanel" LastChildFill="True">
                <!-- Back to the normal window (app icon) -->
                <Button x:Name="HomeButton" Style="{StaticResource BarButton}" Command="{Binding Shell.ShowNormalCommand}"
                        ToolTip="{Binding [Normal_Tooltip], Source={x:Static loc:Loc.Instance}}"
                        AutomationProperties.Name="{Binding [Normal_Tooltip], Source={x:Static loc:Loc.Instance}}">
                    <Image Source="pack://application:,,,/BrowserFlip;component/Assets/browserflip-64.png"
                           Width="{Binding Shell.BarIconSize}" Height="{Binding Shell.BarIconSize}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>
                <!-- Always on top -->
                <!-- Same PinToggle as the main window. IsChecked is two-way bound to Shell.IsTopmost (the single source
                     of truth; no Command, so a click toggles exactly once). Tooltip / name follow the state. -->
                <ToggleButton x:Name="PinButton" IsChecked="{Binding Shell.IsTopmost, Mode=TwoWay}">
                    <ToggleButton.Resources>
                        <CornerRadius x:Key="PinToggleCornerRadius">8</CornerRadius>
                    </ToggleButton.Resources>
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource PinToggle}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="Width" Value="{Binding DataContext.Shell.BarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="Height" Value="{Binding DataContext.Shell.BarButtonSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <!-- Options (opens the normal window with options expanded) -->
                <Button x:Name="OptionsButton" Style="{StaticResource BarButton}" Command="{Binding Shell.OpenOptionsCommand}"
                        ToolTip="{Binding [Options_Header], Source={x:Static loc:Loc.Instance}}"
                        AutomationProperties.Name="{Binding [Options_Header], Source={x:Static loc:Loc.Instance}}">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE713;"
                               Foreground="{DynamicResource BfSecondaryTextBrush}" />
                </Button>
                <!-- Browsers (fills; scrolls when there are many) -->
                <ScrollViewer x:Name="BrowserScroller" Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                              PreviewMouseWheel="OnBrowserScrollerMouseWheel">
                    <ItemsControl x:Name="BrowserList" ItemsSource="{Binding Main.Browsers}" Focusable="False"
                                  KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="{Binding DataContext.Shell.PanelOrientation, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.Main.SelectBrowserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsAvailable}"
                                        AutomationProperties.Name="{Binding AutomationName}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BfAccentBrush}" />
                                                    <Setter Property="Background" Value="{DynamicResource BfInfoBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPartialDefault}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BfWarningForegroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding BadgeText}"
                                                       Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding DetailText}" Opacity="0.8" />
                                        </StackPanel>
                                    </Button.ToolTip>
                                    <Grid Width="{Binding DataContext.Shell.BarIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Height="{Binding DataContext.Shell.BarIconSize, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE774;" FontSize="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Collapsed tab (auto-hide). Hover expands after a short dwell; click / Enter expands immediately. -->
        <Button x:Name="TabButton" Click="OnTabClick" Cursor="Hand" FocusVisualStyle="{StaticResource FocusVisual}"
                ToolTip="{Binding [Bar_ShowTab], Source={x:Static loc:Loc.Instance}}"
                AutomationProperties.Name="{Binding [Bar_ShowTab], Source={x:Static loc:Loc.Instance}}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Pill" CornerRadius="2" Background="{DynamicResource BfAccentBrush}" Opacity="0.9" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Pill" Property="Opacity" Value="1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Shell.IsBarCollapsed}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
