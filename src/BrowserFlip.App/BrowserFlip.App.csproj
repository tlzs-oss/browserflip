<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>BrowserFlip.App</RootNamespace>
    <AssemblyName>BrowserFlip</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF requires public types for XAML; resources are accessed through ResourceManager. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrowserFlip.Core\BrowserFlip.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BrowserFlip.App.Tests" />
  </ItemGroup>

</Project>
