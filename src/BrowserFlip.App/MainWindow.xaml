<Window x:Class="BrowserFlip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BrowserFlip.App.Localization"
        xmlns:vm="clr-namespace:BrowserFlip.App.ViewModels"
        xmlns:ctl="clr-namespace:BrowserFlip.App.Controls"
        xmlns:svc="clr-namespace:BrowserFlip.App.Services"
        Title="BrowserFlip"
        Icon="pack://application:,,,/BrowserFlip;component/Assets/browserflip.ico"
        Width="520" SizeToContent="Height" MinWidth="460" MinHeight="260"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource BfWindowBackgroundBrush}"
        Foreground="{DynamicResource BfPrimaryTextBrush}"
        FontSize="13">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Compact strip used for the current default, warnings and status messages. -->
        <Style x:Key="Strip" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Background" Value="{DynamicResource BfInfoBackgroundBrush}" />
        </Style>
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>

    <!-- v0.3: menu bar + one host per view. The Classic view below is the v0.2 window content, unchanged. -->
    <DockPanel x:Name="RootDock">
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Margin="4,2,4,0" Padding="0" MinHeight="0" Background="Transparent"
              DataContext="{Binding Shell, RelativeSource={RelativeSource AncestorType=Window}}">
            <Menu.Resources>
                <!-- Compact drop-down items and separators (the top-level items have their own explicit style). -->
                <Style TargetType="MenuItem" BasedOn="{StaticResource BfMenuDropItem}" />
                <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource BfMenuSeparator}" />
            </Menu.Resources>
            <MenuItem x:Name="FileMenu" Style="{StaticResource BfMenuBarItem}" Header="{Binding [MenuBar_File], Source={x:Static loc:Loc.Instance}}">
                <MenuItem x:Name="RefreshMenuItem" Header="{Binding [MenuBar_RefreshBrowsers], Source={x:Static loc:Loc.Instance}}" InputGestureText="F5"
                          Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Separator />
                <MenuItem x:Name="ExitMenuItem" Header="{Binding [MenuBar_Exit], Source={x:Static loc:Loc.Instance}}" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem x:Name="ViewMenu" Style="{StaticResource BfMenuBarItem}" Header="{Binding [MenuBar_View], Source={x:Static loc:Loc.Instance}}">
                <MenuItem x:Name="ClassicViewMenuItem" IsCheckable="True" Header="{Binding [View_Classic], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding IsClassicView, Mode=OneWay}"
                          Command="{Binding SetViewCommand}" CommandParameter="{x:Static svc:MainView.Classic}" />
                <MenuItem x:Name="ListViewMenuItem" IsCheckable="True" Header="{Binding [View_List], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding IsListView, Mode=OneWay}"
                          Command="{Binding SetViewCommand}" CommandParameter="{x:Static svc:MainView.List}" />
                <MenuItem x:Name="CardViewMenuItem" IsCheckable="True" Header="{Binding [View_Card], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding IsCardView, Mode=OneWay}"
                          Command="{Binding SetViewCommand}" CommandParameter="{x:Static svc:MainView.Card}" />
                <MenuItem x:Name="CompactViewMenuItem" IsCheckable="True" Header="{Binding [View_Compact], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding IsCompactView, Mode=OneWay}"
                          Command="{Binding SetViewCommand}" CommandParameter="{x:Static svc:MainView.Compact}" />
                <MenuItem x:Name="PanelViewMenuItem" IsCheckable="True" Header="{Binding [View_Panel], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding IsPanelView, Mode=OneWay}"
                          Command="{Binding SetViewCommand}" CommandParameter="{x:Static svc:MainView.Panel}" />
                <Separator />
                <MenuItem x:Name="ToolbarMenuItem" Header="{Binding [MenuBar_FloatingToolbar], Source={x:Static loc:Loc.Instance}}" Command="{Binding EnterCompactCommand}" />
                <MenuItem x:Name="TrayModeMenuItem" Header="{Binding [MenuBar_TrayMode], Source={x:Static loc:Loc.Instance}}" Command="{Binding TrayModeCommand}" />
            </MenuItem>
            <MenuItem x:Name="SettingsMenu" Style="{StaticResource BfMenuBarItem}" Header="{Binding [MenuBar_Settings], Source={x:Static loc:Loc.Instance}}">
                <MenuItem x:Name="PreferencesMenuItem" Header="{Binding [MenuBar_Preferences], Source={x:Static loc:Loc.Instance}}"
                          Command="{Binding OpenSettingsCommand}" CommandParameter="{x:Static vm:SettingsPage.General}" />
                <MenuItem x:Name="ToolbarSettingsMenuItem" Header="{Binding [MenuBar_ToolbarSettings], Source={x:Static loc:Loc.Instance}}"
                          Command="{Binding OpenSettingsCommand}" CommandParameter="{x:Static vm:SettingsPage.FloatingToolbar}" />
            </MenuItem>
            <MenuItem x:Name="HelpMenu" Style="{StaticResource BfMenuBarItem}" Header="{Binding [MenuBar_Help], Source={x:Static loc:Loc.Instance}}">
                <MenuItem x:Name="AboutMenuItem" Header="{Binding [MenuBar_About], Source={x:Static loc:Loc.Instance}}" Command="{Binding OpenAboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- One cell for both hosts: the DockPanel fills only its last child, so the view host must share it with the
             Classic content (otherwise a new view would be docked at its desired width, not the window width). -->
        <Grid x:Name="ViewArea">
        <!-- List / Card / Compact / Panel (created on first use, then reused). -->
        <ContentControl x:Name="ViewHost" Focusable="False" IsTabStop="False" Visibility="Collapsed" TextElement.FontSize="{StaticResource BfFontBody}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

    <ScrollViewer x:Name="RootScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="16,4,16,8">

            <!-- Header (BF-07): brand (icon, name, tagline) | tools (language, always on top, compact bar, refresh).
                 HeaderPanel never overlaps or pushes out the tools: one line, then the tagline wraps, then two rows. -->
            <ctl:HeaderPanel x:Name="Header">
                <DockPanel x:Name="HeaderBrand" VerticalAlignment="Center" LastChildFill="True">
                    <Image DockPanel.Dock="Left" Source="pack://application:,,,/BrowserFlip;component/Assets/browserflip-64.png" Width="28" Height="28" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle" Text="{Binding [AppTitle], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="HeaderTagline" Text="{Binding [Tagline], Source={x:Static loc:Loc.Instance}}" FontSize="11.5"
                                   Foreground="{DynamicResource BfSecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <StackPanel x:Name="HeaderTools" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox MinWidth="104" Height="30" VerticalAlignment="Center"
                              ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.Name="{Binding [Language], Source={x:Static loc:Loc.Instance}}"
                              ToolTip="{Binding [Language], Source={x:Static loc:Loc.Instance}}" />
                    <!-- Always on top -->
                    <!-- Always on top: shared PinToggle (tilted grey pin = off, upright white pin on blue = on);
                         tooltip and accessible name follow the state. -->
                    <ToggleButton x:Name="PinToggleButton" Style="{StaticResource PinToggle}" Width="32" Height="30" Margin="6,0,0,0"
                                  DataContext="{Binding Shell, RelativeSource={RelativeSource AncestorType=Window}}"
                                  IsChecked="{Binding IsTopmost, Mode=TwoWay}" />
                    <!-- Compact bar -->
                    <Button Style="{StaticResource HeaderIconButton}"
                            Command="{Binding Shell.EnterCompactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{Binding [Compact_Tooltip], Source={x:Static loc:Loc.Instance}}"
                            AutomationProperties.Name="{Binding [Compact_Tooltip], Source={x:Static loc:Loc.Instance}}">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE73F;" />
                    </Button>
                    <!-- Refresh (F5) -->
                    <Button Style="{StaticResource HeaderIconButton}" Command="{Binding RefreshCommand}"
                            ToolTip="{Binding [Refresh_Tooltip], Source={x:Static loc:Loc.Instance}}"
                            AutomationProperties.Name="{Binding [Refresh], Source={x:Static loc:Loc.Instance}}">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" />
                    </Button>
                </StackPanel>
            </ctl:HeaderPanel>

            <!-- Current default (F04) -->
            <Border AutomationProperties.LiveSetting="Polite" Margin="0,10,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Strip}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BfWarningBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,1,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
                                <Setter Property="Text" Value="&#xE774;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                                        <Setter Property="Text" Value="&#xE7BA;" />
                                        <Setter Property="Foreground" Value="{DynamicResource BfWarningForegroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding CurrentDefaultText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Policy warning (F05) -->
            <Border Visibility="{Binding IsAssociationsManaged, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Strip}">
                        <Setter Property="Background" Value="{DynamicResource BfWarningBackgroundBrush}" />
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding [Warning_Managed], Source={x:Static loc:Loc.Instance}}" TextWrapping="Wrap" FontSize="12.5" />
            </Border>

            <!-- Status / guidance -->
            <Border AutomationProperties.LiveSetting="Assertive">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Strip}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageKind}" Value="{x:Static vm:MessageKind.None}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MessageKind}" Value="{x:Static vm:MessageKind.Success}">
                                <Setter Property="Background" Value="{DynamicResource BfSuccessBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MessageKind}" Value="{x:Static vm:MessageKind.Warning}">
                                <Setter Property="Background" Value="{DynamicResource BfWarningBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MessageKind}" Value="{x:Static vm:MessageKind.Error}">
                                <Setter Property="Background" Value="{DynamicResource BfErrorBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding MessageText}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12.5" />
                    <TextBlock Text="{Binding GuidanceText}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12.5"
                               Visibility="{Binding IsWaitingForChange, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Browser cards (F01/F02/F03): 2 columns, icon + name + state -->
            <Grid Margin="-4,8,-4,0">
                <ItemsControl ItemsSource="{Binding Browsers}" Focusable="False"
                              KeyboardNavigation.TabNavigation="Continue"
                              AutomationProperties.Name="{Binding [Section_Browsers], Source={x:Static loc:Loc.Instance}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BrowserCardViewModel}">
                            <Button Style="{StaticResource BrowserCard}" Margin="4" Padding="10,6"
                                    Command="{Binding DataContext.SelectBrowserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding IsAvailable}"
                                    ToolTip="{Binding DetailText}"
                                    ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="{Binding AutomationName}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE774;" FontSize="22"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                        <!-- State line: badge when (partially) default, otherwise a one-line hint.
                                             An unavailable browser always shows "Not found", even if it is still the default. -->
                                        <Grid Margin="0,2,0,0">
                                            <Border HorizontalAlignment="Left" Padding="6,0,6,1" CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BfAccentBrush}" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasBadge}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPartialDefault}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BfWarningBackgroundBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding BadgeText}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource BfAccentForegroundBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPartialDefault}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BfPrimaryTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding HintText}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource BfSecondaryTextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasBadge}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding [Empty_NoBrowsers], Source={x:Static loc:Loc.Instance}}" Margin="4,12"
                           HorizontalAlignment="Center" Foreground="{DynamicResource BfSecondaryTextBrush}"
                           Visibility="{Binding HasNoBrowsers, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Display options (collapsible). The window grows to fit; beyond the work area it scrolls. -->
            <Expander Margin="0,6,0,0"
                      DataContext="{Binding Shell, RelativeSource={RelativeSource AncestorType=Window}}"
                      IsExpanded="{Binding IsOptionsOpen, Mode=TwoWay}"
                      Header="{Binding [Options_Header], Source={x:Static loc:Loc.Instance}}">
                <!-- The Fluent Expander already draws the content panel; no extra card frame. -->
                <Border Padding="2,0,2,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Docking, auto-hide and the notification-area icon are fixed behavior (no options):
                             drag the compact bar to any screen edge to dock it; it hides there and comes back on hover. -->
                        <TextBlock Grid.Row="0" Margin="0,4,0,0" VerticalAlignment="Center" Text="{Binding [Options_Theme], Source={x:Static loc:Loc.Instance}}" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Width="132" Margin="8,4,0,0" ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="{Binding [Options_Theme], Source={x:Static loc:Loc.Instance}}" />

                        <TextBlock Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Center" Text="{Binding [Options_BarSize], Source={x:Static loc:Loc.Instance}}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Width="132" Margin="8,6,0,0" ItemsSource="{Binding BarSizes}"
                                  SelectedItem="{Binding SelectedBarSize, Mode=TwoWay}" DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="{Binding [Options_BarSize], Source={x:Static loc:Loc.Instance}}" />

                        <TextBlock Grid.Row="2" Margin="0,6,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="{Binding [Options_FloatingOrientation], Source={x:Static loc:Loc.Instance}}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Width="132" Margin="8,6,0,0" ItemsSource="{Binding Orientations}"
                                  SelectedItem="{Binding SelectedOrientation, Mode=TwoWay}" DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="{Binding [Options_FloatingOrientation], Source={x:Static loc:Loc.Instance}}" />
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource BfSecondaryTextBrush}"
                                   Text="{Binding [Options_FloatingOrientationHint], Source={x:Static loc:Loc.Instance}}" />
                    </Grid>
                </Border>
            </Expander>

            <!-- Footer -->
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding OpenDefaultAppsCommand}"
                        Content="{Binding [OpenDefaultApps], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding [Footer_Note], Source={x:Static loc:Loc.Instance}}" FontSize="11.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding [Footer_Note], Source={x:Static loc:Loc.Instance}}"
                           Foreground="{DynamicResource BfSecondaryTextBrush}" Margin="0,0,8,0" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
