<Application x:Class="BrowserFlip.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BrowserFlip.App.Localization"
             xmlns:vm="clr-namespace:BrowserFlip.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Themes/Light.xaml or Themes/Dark.xaml is inserted at index 0 by ThemeManager. -->
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <Style x:Key="FocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="-2" RadiusX="8" RadiusY="8" StrokeThickness="2"
                                       Stroke="{DynamicResource BfPrimaryTextBrush}" SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource BfPrimaryTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource BfControlBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BfCardBorderBrush}" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolbarToggle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{DynamicResource BfPrimaryTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource BfControlBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BfCardBorderBrush}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BfAccentBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfInfoBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource BfAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Always-on-top toggle, shared by the main window header and the compact bar (both orientations).
                 OFF: grey pin tilted 45 degrees on the normal button background ("not fixed").
                 ON: upright white pin on a solid accent-blue background ("fixed").
                 The pin is a vector path rotated by a render transform, so toggling never changes the layout.
                 A host can override the corner radius with a PinToggleCornerRadius resource on the button. -->
            <CornerRadius x:Key="PinToggleCornerRadius">4</CornerRadius>
            <Geometry x:Key="PinIconGeometry">M5,1 H11 V3 H10 V8 L13,10.5 H3 L6,8 V3 H5 Z M7.25,10.5 H8.75 V15.5 H7.25 Z</Geometry>
            <Style x:Key="PinToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="{DynamicResource BfControlBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BfCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                <Setter Property="ToolTip" Value="{Binding [Pin_TooltipOff], Source={x:Static loc:Loc.Instance}}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding [Pin_TooltipOff], Source={x:Static loc:Loc.Instance}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource PinToggleCornerRadius}"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="PinIcon" Width="16" Height="16" Stretch="None"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="{StaticResource PinIconGeometry}" Fill="{DynamicResource BfPinOffForegroundBrush}"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </Path.RenderTransform>
                                </Path>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardHoverBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BfPinOffHoverBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfPinOnBackgroundBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BfPinOnBorderBrush}" />
                                    <Setter TargetName="PinIcon" Property="Fill" Value="{DynamicResource BfPinOnForegroundBrush}" />
                                    <Setter TargetName="PinIcon" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="0" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True" />
                                        <Condition Property="IsMouseOver" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfPinOnHoverBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BfPinOnHoverBorderBrush}" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True" />
                                        <Condition Property="IsPressed" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfPinOnPressedBrush}" />
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="ToolTip" Value="{Binding [Pin_TooltipOn], Source={x:Static loc:Loc.Instance}}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                <Setter Property="Foreground" Value="{DynamicResource BfAccentBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="4,2" />
            </Style>

            <Style x:Key="BrowserCard" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource BfPrimaryTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource BfCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BfCardBorderBrush}" />
                <Setter Property="Margin" Value="6" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource BfAccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Shared by the v0.3 views (List, Card, Compact, Panel) and the Settings / About windows.
                 The Classic view keeps its own v0.2 markup in MainWindow.xaml unchanged. -->

            <!-- Menu bar (v0.3): a compact, traditional bar. The Fluent top-level item template is ~45 DIP tall (fixed
                 inner margins), so the top-level items get this template; the drop-down items keep the Fluent style. -->
            <Style x:Key="BfMenuBarItem" TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource BfPrimaryTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="FontSize" Value="{StaticResource BfFontBody}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                    <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2" Focusable="False" AllowsTransparency="True"
                                           PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Border Margin="0,0,10,10" Padding="4" CornerRadius="8" BorderThickness="1"
                                                Background="{DynamicResource BfCardBackgroundBrush}" BorderBrush="{DynamicResource BfCardBorderBrush}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" />
                                            </Border.Effect>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"
                                                                Grid.IsSharedSizeScope="True" />
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSubmenuOpen" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============================================================ design tokens (v0.3 Phase 4)
                 Type ramp = the Windows 11 type ramp (Caption 12, Body / Body Strong 14, Body Large 18, Subtitle 20);
                 spacing on the 4 epx grid (4 / 8 / 12 / 16 / 24); corner radius 4 (in-page controls, list rows,
                 setting cards), 8 (cards / tiles, flyouts, menus, windows). See docs: UI_DESIGN_SPEC.ja.md.
                 The Classic view keeps its v0.2 sizes (compatibility). -->
            <sys:Double x:Key="BfFontCaption">12</sys:Double>
            <sys:Double x:Key="BfFontBody">14</sys:Double>
            <sys:Double x:Key="BfFontBodyLarge">18</sys:Double>
            <sys:Double x:Key="BfFontSubtitle">20</sys:Double>
            <sys:Double x:Key="BfIconRow">32</sys:Double>
            <sys:Double x:Key="BfIconGlyph">16</sys:Double>
            <sys:Double x:Key="BfControlHeight">32</sys:Double>

            <!-- Tile size (Card view; the Panel view overrides it with smaller tiles). -->
            <sys:Double x:Key="BfTileWidth">148</sys:Double>
            <sys:Double x:Key="BfTileHeight">128</sys:Double>
            <sys:Double x:Key="BfTileIcon">40</sys:Double>

            <!-- Navigation entries (Panel view list, Settings window tabs): one look (UI-12). Hover = light tint;
                 selected = blue tint + accent pill (not colour alone: the pill marks it too); keyboard focus = ring. -->
            <Style x:Key="BfNavItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource BfPrimaryTextBrush}" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,5" SnapsToDevicePixels="True">
                                <Grid>
                                    <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Margin="-10,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{DynamicResource BfAccentBrush}" Visibility="Collapsed" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfInfoBackgroundBrush}" />
                                    <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BfNavTab" TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource BfPrimaryTextBrush}" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,6" SnapsToDevicePixels="True">
                                <Grid>
                                    <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Margin="-12,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{DynamicResource BfAccentBrush}" Visibility="Collapsed" />
                                    <ContentPresenter x:Name="HeaderText" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfInfoBackgroundBrush}" />
                                    <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                    <!-- Only the header: the page content (the selected TabItem's content) must not turn bold. -->
                                    <Setter TargetName="HeaderText" Property="TextElement.FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BfStrip" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="Background" Value="{DynamicResource BfInfoBackgroundBrush}" />
            </Style>

            <Style x:Key="BfGlyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="BfSectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource BfFontBody}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource BfSecondaryTextBrush}" />
                <Setter Property="Margin" Value="0,16,0,8" />
            </Style>

            <Style x:Key="BfCardPanel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BfCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BfCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- Browser icon, or a globe glyph when the icon could not be loaded (never fails on a missing icon). -->
            <DataTemplate x:Key="BrowserIconTemplate" DataType="{x:Type vm:BrowserCardViewModel}">
                <Grid>
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                    <Viewbox>
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE774;" />
                    </Viewbox>
                </Grid>
            </DataTemplate>

            <!-- Default / http only / https only badge. Hidden for an unavailable browser (its hint says "Not found"). -->
            <Style x:Key="BfBadge" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BfAccentBrush}" />
                <Setter Property="Padding" Value="6,0,6,1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasBadge}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPartialDefault}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BfWarningBackgroundBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BfBadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{DynamicResource BfAccentForegroundBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPartialDefault}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource BfPrimaryTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A flat list row (List view, Panel view "Browsers"): the whole row is one button. -->
            <Style x:Key="BfListRow" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource BfPrimaryTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BfCardPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BfInfoBackgroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- One browser as a list row: icon | name + hint | badge or "Set as default". Clicking runs the same
                 SelectBrowserCommand as the Classic cards (Windows Settings opens and the result is read back). -->
            <DataTemplate x:Key="BrowserRowTemplate" DataType="{x:Type vm:BrowserCardViewModel}">
                <Button Style="{StaticResource BfListRow}" Margin="0,1"
                        Command="{Binding DataContext.SelectBrowserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding IsAvailable}"
                        ToolTip="{Binding ToolTipText}"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="{Binding AutomationName}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Width="{StaticResource BfIconRow}" Height="{StaticResource BfIconRow}" Margin="0,0,12,0" Focusable="False" IsTabStop="False"
                                        Content="{Binding}" ContentTemplate="{StaticResource BrowserIconTemplate}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="{StaticResource BfFontBody}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding HintText}" FontSize="{StaticResource BfFontCaption}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource BfSecondaryTextBrush}" />
                        </StackPanel>
                        <Border Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource BfBadge}">
                            <TextBlock Text="{Binding BadgeText}" Style="{StaticResource BfBadgeText}" />
                        </Border>
                        <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource BfFontBody}"
                                   Text="{Binding [List_SetDefault], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="{DynamicResource BfAccentBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBadge}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>
            </DataTemplate>

            <!-- One browser as a tile (Card view, Panel view "Home"). -->
            <DataTemplate x:Key="BrowserTileTemplate" DataType="{x:Type vm:BrowserCardViewModel}">
                <Button Style="{StaticResource BrowserCard}" Width="{DynamicResource BfTileWidth}" Height="{DynamicResource BfTileHeight}"
                        Margin="6" Padding="10,10"
                        Command="{Binding DataContext.SelectBrowserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding IsAvailable}"
                        ToolTip="{Binding ToolTipText}"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="{Binding AutomationName}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentControl Width="{DynamicResource BfTileIcon}" Height="{DynamicResource BfTileIcon}" HorizontalAlignment="Center" Focusable="False" IsTabStop="False"
                                        Content="{Binding}" ContentTemplate="{StaticResource BrowserIconTemplate}" />
                        <TextBlock Text="{Binding DisplayName}" Margin="0,8,0,0" FontWeight="SemiBold" FontSize="{StaticResource BfFontBody}" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                        <Grid Margin="0,4,0,0" HorizontalAlignment="Center">
                            <Border Style="{StaticResource BfBadge}" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding BadgeText}" Style="{StaticResource BfBadgeText}" />
                            </Border>
                            <TextBlock Text="{Binding HintText}" FontSize="{StaticResource BfFontCaption}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxHeight="34" LineStackingStrategy="BlockLineHeight" LineHeight="15"
                                       Foreground="{DynamicResource BfSecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBadge}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
