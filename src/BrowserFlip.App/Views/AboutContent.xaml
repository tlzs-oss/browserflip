<UserControl x:Class="BrowserFlip.App.Views.AboutContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BrowserFlip.App.Localization"
             Focusable="False">
    <!-- Shared by Help > About and the Panel view's About page. -->
    <StackPanel MaxWidth="460">
        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/BrowserFlip;component/Assets/browserflip-64.png" Width="48" Height="48"
                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding [AppTitle], Source={x:Static loc:Loc.Instance}}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" FontSize="12.5" Foreground="{DynamicResource BfSecondaryTextBrush}">
                    <Run Text="{Binding [About_VersionLabel], Source={x:Static loc:Loc.Instance}, Mode=OneWay}" /><Run Text=" " /><Run x:Name="VersionRun" />
                </TextBlock>
            </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding [Tagline], Source={x:Static loc:Loc.Instance}}" Margin="0,14,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="CopyrightText" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12.5" />
        <TextBlock Text="{Binding [About_License], Source={x:Static loc:Loc.Instance}}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12.5" />
        <TextBlock Text="{Binding [About_ThirdParty], Source={x:Static loc:Loc.Instance}}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12.5"
                   Foreground="{DynamicResource BfSecondaryTextBrush}" />
        <Button x:Name="WebsiteButton" Style="{StaticResource LinkButton}" Margin="-4,10,0,0" HorizontalAlignment="Left"
                Content="{Binding [About_Website], Source={x:Static loc:Loc.Instance}}" Click="OnWebsiteClick" />
    </StackPanel>
</UserControl>
