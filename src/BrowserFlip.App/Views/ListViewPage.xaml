<UserControl x:Class="BrowserFlip.App.Views.ListViewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BrowserFlip.App.Localization"
             xmlns:views="clr-namespace:BrowserFlip.App.Views"
             Focusable="False">
    <!-- List view: Windows 11 style list. One row per browser; the default row is tinted and badged. -->
    <DockPanel Margin="16,4,16,12">
        <views:StatusStrip DockPanel.Dock="Top" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding OpenDefaultAppsCommand}"
                    Content="{Binding [OpenDefaultApps], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding [Footer_Note], Source={x:Static loc:Loc.Instance}}" FontSize="{StaticResource BfFontCaption}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding [Footer_Note], Source={x:Static loc:Loc.Instance}}"
                       Foreground="{DynamicResource BfSecondaryTextBrush}" Margin="0,0,8,0" />
        </DockPanel>

        <Border Style="{StaticResource BfCardPanel}" Margin="0,8,0,0" Padding="4">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl x:Name="BrowserList" ItemsSource="{Binding Browsers}" Focusable="False"
                                  KeyboardNavigation.TabNavigation="Continue"
                                  KeyboardNavigation.DirectionalNavigation="Contained"
                                  ItemTemplate="{StaticResource BrowserRowTemplate}"
                                  AutomationProperties.Name="{Binding [Section_Browsers], Source={x:Static loc:Loc.Instance}}" />
                </ScrollViewer>
                <TextBlock Text="{Binding [Empty_NoBrowsers], Source={x:Static loc:Loc.Instance}}" Margin="4,12"
                           HorizontalAlignment="Center" Foreground="{DynamicResource BfSecondaryTextBrush}"
                           Visibility="{Binding HasNoBrowsers, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
