<UserControl x:Class="BrowserFlip.App.Views.CompactViewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BrowserFlip.App.Localization"
             xmlns:vm="clr-namespace:BrowserFlip.App.ViewModels"
             xmlns:views="clr-namespace:BrowserFlip.App.Views"
             Focusable="False">
    <!-- Compact view: current default + one icon button per browser (one click to switch). Messages and
         warnings are still shown (never hidden to save space). -->
    <DockPanel Margin="4,8,16,12">
    <!-- Phase 4: a visible six-dot handle to move the window (native move loop). -->
    <views:DragGrip x:Name="MoveGrip" DockPanel.Dock="Left" MovesWindow="True" Width="32" Margin="0,0,8,0" VerticalAlignment="Stretch" />
    <StackPanel>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Width="30" Height="28" Padding="0"
                    VerticalAlignment="Center" Command="{Binding RefreshCommand}"
                    ToolTip="{Binding [Refresh_Tooltip], Source={x:Static loc:Loc.Instance}}"
                    AutomationProperties.Name="{Binding [Refresh], Source={x:Static loc:Loc.Instance}}">
                <TextBlock Style="{StaticResource BfGlyph}" Text="&#xE72C;" />
            </Button>
            <Grid DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                <ContentControl Content="{Binding DefaultCard}" ContentTemplate="{StaticResource BrowserIconTemplate}"
                                Focusable="False" IsTabStop="False"
                                Visibility="{Binding HasDefaultCard, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock FontSize="{StaticResource BfFontSubtitle}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BfGlyph}">
                            <Setter Property="Text" Value="&#xE774;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDefaultCard}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                                    <Setter Property="Text" Value="&#xE7BA;" />
                                    <Setter Property="Foreground" Value="{DynamicResource BfWarningForegroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding CurrentDefaultText}"
                        AutomationProperties.Name="{Binding CurrentDefaultText}" AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="{Binding [Home_Current], Source={x:Static loc:Loc.Instance}}" FontSize="{StaticResource BfFontCaption}"
                           Foreground="{DynamicResource BfSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CurrentDefaultName}" FontWeight="SemiBold" FontSize="{StaticResource BfFontBodyLarge}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <!-- http and https differ: say so in full (the short name alone would hide it). -->
        <TextBlock Text="{Binding CurrentDefaultText}" TextWrapping="Wrap" FontSize="{StaticResource BfFontCaption}" Margin="0,6,0,0"
                   Foreground="{DynamicResource BfWarningForegroundBrush}"
                   Visibility="{Binding IsMismatch, Converter={StaticResource BoolToVisibility}}" />

        <ItemsControl x:Name="BrowserButtons" ItemsSource="{Binding Browsers}" Margin="-4,8,-4,0" Focusable="False"
                      KeyboardNavigation.TabNavigation="Continue"
                      KeyboardNavigation.DirectionalNavigation="Contained"
                      AutomationProperties.Name="{Binding [Section_Browsers], Source={x:Static loc:Loc.Instance}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BrowserCardViewModel}">
                    <Button Style="{StaticResource BrowserCard}" Width="60" Height="60" Margin="4" Padding="0"
                            Command="{Binding DataContext.SelectBrowserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding IsAvailable}"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="{Binding AutomationName}">
                        <Button.ToolTip>
                            <StackPanel>
                                <TextBlock Text="{Binding ToolTipTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DetailText}" />
                            </StackPanel>
                        </Button.ToolTip>
                        <Grid>
                            <ContentControl Width="36" Height="36" HorizontalAlignment="Center" Focusable="False" IsTabStop="False"
                                            Content="{Binding}" ContentTemplate="{StaticResource BrowserIconTemplate}" />
                            <!-- Default mark: a check badge, so the state is not shown by colour alone. -->
                            <Border Width="14" Height="14" CornerRadius="7" Margin="0,0,-10,-10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Background="{DynamicResource BfAccentBrush}" BorderBrush="{DynamicResource BfCardBackgroundBrush}" BorderThickness="1.5"
                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" FontSize="7.5"
                                           Foreground="{DynamicResource BfAccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding [Empty_NoBrowsers], Source={x:Static loc:Loc.Instance}}" Margin="0,8,0,0"
                   Foreground="{DynamicResource BfSecondaryTextBrush}" TextWrapping="Wrap"
                   Visibility="{Binding HasNoBrowsers, Converter={StaticResource BoolToVisibility}}" />

        <views:StatusStrip ShowCurrent="False" />
    </StackPanel>
    </DockPanel>
</UserControl>
