<UserControl x:Class="BrowserFlip.App.Views.StatusStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BrowserFlip.App.Localization"
             xmlns:vm="clr-namespace:BrowserFlip.App.ViewModels"
             Focusable="False">
    <!-- Current default, policy warning and status / guidance: the same information (and the same view-model
         properties) as the Classic view, so no view can show a different or "pretended" state. -->
    <StackPanel>
        <Border AutomationProperties.LiveSetting="Polite" Margin="0" x:Name="CurrentStrip"
                Visibility="{Binding ShowCurrent, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource BfStrip}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BfWarningBackgroundBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,1,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BfGlyph}">
                            <Setter Property="Text" Value="&#xE774;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                                    <Setter Property="Text" Value="&#xE7BA;" />
                                    <Setter Property="Foreground" Value="{DynamicResource BfWarningForegroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding CurrentDefaultText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border Visibility="{Binding IsAssociationsManaged, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource BfStrip}">
                    <Setter Property="Background" Value="{DynamicResource BfWarningBackgroundBrush}" />
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding [Warning_Managed], Source={x:Static loc:Loc.Instance}}" TextWrapping="Wrap" FontSize="{StaticResource BfFontBody}" />
        </Border>

        <Border AutomationProperties.LiveSetting="Assertive">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource BfStrip}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MessageKind}" Value="{x:Static vm:MessageKind.None}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MessageKind}" Value="{x:Static vm:MessageKind.Success}">
                            <Setter Property="Background" Value="{DynamicResource BfSuccessBackgroundBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MessageKind}" Value="{x:Static vm:MessageKind.Warning}">
                            <Setter Property="Background" Value="{DynamicResource BfWarningBackgroundBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MessageKind}" Value="{x:Static vm:MessageKind.Error}">
                            <Setter Property="Background" Value="{DynamicResource BfErrorBackgroundBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding MessageText}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="{StaticResource BfFontBody}" />
                <TextBlock Text="{Binding GuidanceText}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="{StaticResource BfFontBody}"
                           Visibility="{Binding IsWaitingForChange, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
