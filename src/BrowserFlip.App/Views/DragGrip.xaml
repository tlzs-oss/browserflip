<UserControl x:Class="BrowserFlip.App.Views.DragGrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BrowserFlip.App.Localization"
             Focusable="False" Cursor="SizeAll"
             MinWidth="32" MinHeight="32"
             ToolTip="{Binding [Drag_Tooltip], Source={x:Static loc:Loc.Instance}}"
             AutomationProperties.Name="{Binding [Drag_Tooltip], Source={x:Static loc:Loc.Instance}}">
    <!-- Six-dot grip (Phase 4): always visible, at least 32 x 32 epx to hit, light hover background.
         Vertical dots (2 x 3) beside a horizontal row of buttons; horizontal dots (3 x 2) above a vertical one. -->
    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" SnapsToDevicePixels="True">
        <UniformGrid x:Name="Dots" Rows="3" Columns="2" Width="8" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="3" Height="3" Fill="{DynamicResource BfSecondaryTextBrush}" />
            <Ellipse Width="3" Height="3" Fill="{DynamicResource BfSecondaryTextBrush}" />
            <Ellipse Width="3" Height="3" Fill="{DynamicResource BfSecondaryTextBrush}" />
            <Ellipse Width="3" Height="3" Fill="{DynamicResource BfSecondaryTextBrush}" />
            <Ellipse Width="3" Height="3" Fill="{DynamicResource BfSecondaryTextBrush}" />
            <Ellipse Width="3" Height="3" Fill="{DynamicResource BfSecondaryTextBrush}" />
        </UniformGrid>
    </Border>
</UserControl>
