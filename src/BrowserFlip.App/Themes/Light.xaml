<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BfWindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="BfCardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BfCardHoverBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="BfCardPressedBrush" Color="#EEF2F8" />
    <SolidColorBrush x:Key="BfCardBorderBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="BfAccentBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="BfAccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BfPrimaryTextBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="BfSecondaryTextBrush" Color="#5C5C5C" />
    <SolidColorBrush x:Key="BfInfoBackgroundBrush" Color="#E8F1FB" />
    <SolidColorBrush x:Key="BfSuccessBackgroundBrush" Color="#DFF6DD" />
    <SolidColorBrush x:Key="BfWarningBackgroundBrush" Color="#FFF4CE" />
    <SolidColorBrush x:Key="BfErrorBackgroundBrush" Color="#FDE7E9" />
    <SolidColorBrush x:Key="BfWarningForegroundBrush" Color="#8A5300" />
    <SolidColorBrush x:Key="BfErrorForegroundBrush" Color="#A4262C" />
    <SolidColorBrush x:Key="BfSuccessForegroundBrush" Color="#0E700E" />
    <SolidColorBrush x:Key="BfControlBackgroundBrush" Color="#FFFFFF" />
    <!-- Always-on-top toggle. ON = solid accent blue with a white pin (white on it: 6.3:1, hover 8.3:1, pressed 10.5:1). -->
    <SolidColorBrush x:Key="BfPinOffForegroundBrush" Color="#5C5C5C" />
    <SolidColorBrush x:Key="BfPinOffHoverBorderBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="BfPinOnBackgroundBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="BfPinOnHoverBrush" Color="#004E98" />
    <SolidColorBrush x:Key="BfPinOnPressedBrush" Color="#003F7D" />
    <SolidColorBrush x:Key="BfPinOnBorderBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="BfPinOnHoverBorderBrush" Color="#004E98" />
    <SolidColorBrush x:Key="BfPinOnForegroundBrush" Color="#FFFFFF" />
</ResourceDictionary>
