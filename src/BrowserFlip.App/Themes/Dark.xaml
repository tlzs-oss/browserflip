<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BfWindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="BfCardBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="BfCardHoverBrush" Color="#323232" />
    <SolidColorBrush x:Key="BfCardPressedBrush" Color="#272727" />
    <SolidColorBrush x:Key="BfCardBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="BfAccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="BfAccentForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="BfPrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BfSecondaryTextBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="BfInfoBackgroundBrush" Color="#1F3347" />
    <SolidColorBrush x:Key="BfSuccessBackgroundBrush" Color="#1E3A1E" />
    <SolidColorBrush x:Key="BfWarningBackgroundBrush" Color="#433519" />
    <SolidColorBrush x:Key="BfErrorBackgroundBrush" Color="#442726" />
    <SolidColorBrush x:Key="BfWarningForegroundBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="BfErrorForegroundBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="BfSuccessForegroundBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="BfControlBackgroundBrush" Color="#2D2D2D" />
    <!-- Always-on-top toggle. The dark accent (#60CDFF) cannot carry white, so ON uses the deeper Windows accent blue
         (white on it: 5.7:1, hover 4.7:1, pressed 7.4:1). -->
    <SolidColorBrush x:Key="BfPinOffForegroundBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="BfPinOffHoverBorderBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="BfPinOnBackgroundBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="BfPinOnHoverBrush" Color="#1A75CC" />
    <SolidColorBrush x:Key="BfPinOnPressedBrush" Color="#00569F" />
    <SolidColorBrush x:Key="BfPinOnBorderBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="BfPinOnHoverBorderBrush" Color="#1A75CC" />
    <SolidColorBrush x:Key="BfPinOnForegroundBrush" Color="#FFFFFF" />
</ResourceDictionary>
