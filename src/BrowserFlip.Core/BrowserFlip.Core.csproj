<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0: portable Core (builds and tests on macOS/Linux).
         net10.0-windows: adds the Windows implementations under Platform/Windows. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <RootNamespace>BrowserFlip.Core</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Windows-only implementations (P/Invoke, registry). Excluded from the portable target. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Platform\Windows\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BrowserFlip.Core.Tests" />
    <InternalsVisibleTo Include="BrowserFlip.App.Tests" />
  </ItemGroup>

</Project>
